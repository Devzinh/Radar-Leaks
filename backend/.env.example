PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/radar
APP_ORIGIN=http://127.0.0.1:5173
# Generate password hash: node scripts/hash-password.js your-long-password
ADMIN_PASSWORD_HASH=
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
FINGERPRINT_SECRET=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=
# Set production behind HTTPS; serve frontend and /api on APP_ORIGIN.
NODE_ENV=development
